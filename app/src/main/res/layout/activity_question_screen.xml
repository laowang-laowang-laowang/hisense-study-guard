<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_screen_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="40dp">

    <!-- 中间主答题卡片容器 -->
    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="1100dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp"
        android:paddingBottom="36dp">

        <!-- 分类徽章标签 -->
        <TextView
            android:id="@+id/tv_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜 【分类加载中】"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 题目文字 -->
        <TextView
            android:id="@+id/tv_question_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="36dp"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:text="题目加载中..."
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- 第一行选项 A 和 B -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_option_a"
                android:layout_width="460dp"
                android:layout_height="76dp"
                android:layout_margin="12dp"
                android:focusable="true"
                android:nextFocusRight="@+id/btn_option_b"
                android:nextFocusDown="@+id/btn_option_c"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_option_b"
                android:layout_width="460dp"
                android:layout_height="76dp"
                android:layout_margin="12dp"
                android:focusable="true"
                android:nextFocusLeft="@+id/btn_option_a"
                android:nextFocusDown="@+id/btn_option_d"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 第二行选项 C 和 D -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_option_c"
                android:layout_width="460dp"
                android:layout_height="76dp"
                android:layout_margin="12dp"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_option_a"
                android:nextFocusRight="@+id/btn_option_d"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_option_d"
                android:layout_width="460dp"
                android:layout_height="76dp"
                android:layout_margin="12dp"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_option_b"
                android:nextFocusLeft="@+id/btn_option_c"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 底部遥控器操作指引与状态反馈 -->
        <TextView
            android:id="@+id/tv_status_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="使用遥控器【方向键】移动高亮，按【OK键】确认"
            android:textColor="#CCCCCC"
            android:textSize="20sp" />

    </LinearLayout>

</RelativeLayout>
